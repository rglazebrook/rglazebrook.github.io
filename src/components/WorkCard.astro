---
import { Image } from "astro:assets";
import type { WorkItem } from "../data/work";

interface Props { item: WorkItem }
const { item } = Astro.props;
---

<article class="overflow-hidden rounded-md border border-gray-100 bg-surface">
  <a href={item.url}>
    <Image
      src={item.image}
      alt=""
      widths={[400, 800]}
      sizes="(min-width: 48rem) 22rem, 100vw"
      class="aspect-16/9 w-full border-b border-gray-100 object-cover object-top"
    />
  </a>
  <div class="px-6 pt-4 pb-6">
    <h3 class="mb-2 text-lg">
      {item.url ? <a href={item.url} class="no-underline hover:underline">{item.title}</a> : item.title}
    </h3>
    <p class="text-muted">{item.description}</p>
  </div>
</article>
