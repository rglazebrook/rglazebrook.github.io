---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "Rob Glazebrook is a front-end engineer specializing in design systems, accessible UI components, and the occasional game.",
} = Astro.props;
const fullTitle = title ? `${title} · Rob Glazebrook` : "Rob Glazebrook · Front-end engineer";
const path = Astro.url.pathname;
const links = [
  { text: "Work", href: "/#work" },
  { text: "Writing", href: "/writing/", current: path.startsWith("/writing") },
  { text: "Contact", href: "/#contact" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-10 focus:px-4 focus:py-2 bg-accent text-on-accent" href="#main">Skip to content</a>
    <header class="site-header container flex flex-wrap items-center justify-between gap-4 py-3">
      <a class="logo text-text font-bold no-underline" href="/">Rob Glazebrook</a>
      <nav aria-label="Main">
        <ul class="flex gap-6">
          {links.map((link) => (
            <li>
              <a
                class="text-muted no-underline hover:text-text aria-[current=page]:text-text"
                href={link.href}
                aria-current={link.current ? "page" : undefined}
              >
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer container mt-24 py-8 border-t text-muted text-sm border-border">
      <p>© {new Date().getFullYear()} Rob Glazebrook. Built with Astro + MDX.</p>
    </footer>
  </body>
</html>
