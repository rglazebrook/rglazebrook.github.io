---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "Rob Glazebrook is a front-end engineer specializing in design systems, accessible UI components, and the occasional game.",
} = Astro.props;
const fullTitle = title ? `${title} · Rob Glazebrook` : "Rob Glazebrook · Front-end engineer";
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="logo" href="/">Rob Glazebrook</a>
      <nav aria-label="Main">
        <ul>
          <li><a href="/#work">Work</a></li>
          <li><a href="/writing/" aria-current={path.startsWith("/writing") ? "page" : undefined}>Writing</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} Rob Glazebrook. Built with Astro + MDX.</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }
  .logo {
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }
  nav ul {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  nav a:hover, nav a[aria-current="page"] { color: var(--color-text); }
  .site-footer {
    margin-top: var(--space-24);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .visually-hidden:focus {
    position: fixed; top: var(--space-2); left: var(--space-2);
    width: auto; height: auto; clip: auto; margin: 0;
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent); color: var(--color-accent-text);
    z-index: 10;
  }
</style>
