---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import WorkCard from "../components/WorkCard.astro";
import { earlierWork, playground } from "../data/work";

const posts = (await getCollection("writing", ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="hero container">
    <h1>I build the components other engineers build with.</h1>
    <p class="lede">
      I’m Rob Glazebrook, a front-end engineer. For the last 8½ years I helped build and
      maintain an internal design system component library: accessible, themeable, and
      used by product teams across the company.
    </p>
  </section>

  <section class="container section" aria-labelledby="about">
    <h2 id="about">About</h2>
    <div class="prose">
      <p>
        Puzzles are sort of my thing. When I was a kid, I took my toys apart to figure out how
        they worked (and less often, figured out how to put them back together). I built my
        own computers, then wrote text adventures in BASIC to play on them. In 1995 I
        discovered HTML, and I’ve loved it ever since.
      </p>
      <p>
        <!-- TODO: a paragraph on the design-system years: scale, what you owned, what you're proud of. -->
        These days the puzzle I like best is a component API: making something flexible enough
        for dozens of teams, strict enough to stay consistent, and accessible by default.
      </p>
    </div>
  </section>

  <section class="container section" aria-labelledby="writing-heading">
    <h2 id="writing-heading">Writing &amp; deep dives</h2>
    {posts.length === 0 ? (
      <p>Coming soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            {post.data.draft && <span class="badge">draft</span>}
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="work" class="container section" aria-labelledby="play-heading">
    <h2 id="play-heading">Playground</h2>
    <div class="grid">
      {playground.map((item) => <WorkCard item={item} />)}
    </div>
  </section>

  <section class="container section" aria-labelledby="earlier-heading">
    <h2 id="earlier-heading">Earlier client work</h2>
    <div class="grid">
      {earlierWork.map((item) => <WorkCard item={item} />)}
    </div>
  </section>

  <section id="contact" class="container section" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Get in touch</h2>
    <p>Have something interesting you’d like to talk about? I’d love to hear it.</p>
    <ul class="contact">
      <li><a href="mailto:rglazebrook@gmail.com">rglazebrook@gmail.com</a></li>
      <li><a href="https://www.linkedin.com/in/robglazebrook">LinkedIn</a></li>
      <li><a href="https://github.com/rglazebrook">GitHub</a></li>
    </ul>
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-16) var(--space-12); }
  .hero h1 { font-size: var(--text-2xl); max-width: 18ch; margin: 0 0 var(--space-6); }
  .lede { font-size: var(--text-lg); color: var(--color-text-muted); max-width: var(--measure); margin: 0; }
  .section { margin-top: var(--space-16); }
  .section h2 { font-size: var(--text-xl); margin: 0 0 var(--space-6); }
  .grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .post-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-6); }
  .post-list a { font-size: var(--text-lg); font-weight: 600; }
  .post-list p { margin: var(--space-1) 0 0; color: var(--color-text-muted); }
  .badge {
    margin-left: var(--space-2);
    font-size: var(--text-sm);
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }
  .contact { display: flex; flex-wrap: wrap; gap: var(--space-6); list-style: none; padding: 0; }
</style>
