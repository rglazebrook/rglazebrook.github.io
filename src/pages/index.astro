---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { earlierWork, playground } from "../data/work";
import HomeSection from "../components/HomeSection.astro";
import PortfolioGrid from "../components/PortfolioGrid.astro";
import { Image } from "astro:assets";

import rob from "../assets/rob-beer-headshot-2.jpg";

const posts = (await getCollection("writing", ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="hero container mt-16">
    <div class="grid grid-cols-5 gap-2">
      <Image src={rob} alt="That's me!" class="p-2 border border-border" />
      <h1 class="text-2xl max-w-[18ch] mb-6 col-span-4">I build the components other engineers build with.</h1>
    </div>
    <p class="lede text-lg text-muted max-w-measure m-0">
      Hi there! I'm Rob Glazebrook, a frontend engineer. For the last 8.5 years I've built
      and maintained an internal design system component library; it's accessible, themeable, and
      used by product teams across the company.
    </p>
  </section>

  <HomeSection id="about" title="A Bit About Me">
    <div class="prose">
      <p>
        Solving puzzles is sort of my thing. When I was a kid, I took my toys apart to figure out how
        they worked (and less often, figured out how to put them back together). I built my
        own computers, then wrote text adventures in BASIC to play on them. I discovered HTML and the 
        Internet in 1995, and I've loved it ever since.
      </p>
      <p>
        I love design system component work because it's the intersection of design, engineering, and problem solving.
        I get to work with designers to bring their ideas to life, and then work with engineers to ensure 
        those ideas are implemented in a way that meets their product's needs &mdash; while simultaneously 
        ensuring a consistent and accessible user experience within the component library.
      </p>
      <p>
        When I'm not writing code, you can find me hiking, kayaking, building hardware projects, 
        brewing, distillling, baking, cooking, restoring and using retro hardware, 
        and spending time with my kids.
      </p>
    </div>
  </HomeSection>

  <HomeSection id="writing-heading" title="Writing & Deep Dives">
    {posts.length === 0 ? (
      <p>Coming soon.</p>
    ) : (
      <ul class="post-list grid gap-6">
        {posts.map((post) => (
          <li>
            <a href={`/writing/${post.id}/`} class="text-lg font-semibold">
              {post.data.title}
            </a>
            {post.data.draft && <span class="badge ms-2 text-sm px-2 border border-border-strong rounded-sm text-muted">draft</span>}
            <p class="mt-1 text-muted">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </HomeSection>

  <HomeSection id="playground" title="Playground">
    <PortfolioGrid items={playground} />
  </HomeSection>

  <HomeSection id="earlier-work" title="Earlier Client Work">
    <PortfolioGrid items={earlierWork} />
  </HomeSection>

  <HomeSection id="contact" title="Get in touch">
    <p>Have something interesting you'd like to talk about? I'd love to hear it.</p>
    <ul class="contact flex flex-wrap gap-6">
      <li><a href="mailto:rglazebrook@gmail.com">rglazebrook@gmail.com</a></li>
      <li><a href="https://www.linkedin.com/in/robglazebrook">LinkedIn</a></li>
      <li><a href="https://github.com/rglazebrook">GitHub</a></li>
    </ul>
  </HomeSection>
</Base>
