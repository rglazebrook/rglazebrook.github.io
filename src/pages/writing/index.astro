---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("writing", ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" });
---

<Base title="Writing" description="Deep dives on design systems, accessible components, and front-end craft.">
  <div class="container">
    <h1 class="py-6 text-2xl font-semibold">Writing</h1>
    <ul class="grid gap-8">
      {posts.map((post) => (
        <li>
          <a href={`/writing/${post.id}/`} class="text-lg font-bold block">{post.data.title}</a>
          <time class="text-sm text-muted" datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
          {post.data.draft && <span class="text-sm text-muted"> · draft</span>}
          <p class="mt-1 text-muted max-w-measure">{post.data.description}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>

